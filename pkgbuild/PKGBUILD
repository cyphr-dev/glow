pkgname=glow
pkgver=0.1.0
pkgrel=1
pkgdesc='RGB lighting controller for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
optdepends=('openrgb: hardware lighting control and udev rules')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/glow "$pkgdir/usr/bin/glow"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/glow.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/glow.svg"
  install -Dm644 "$startdir/glow.desktop" "$pkgdir/usr/share/applications/glow.desktop"
}
